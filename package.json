{
  "name": "techcapsule",
  "private": true,
  "version": "0.1.0",
  "description": "TechCapsule.dev — mobile-first developer learning platform",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": "^22.13.0 || >=24.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "postinstall": "npm run build -w @techcapsule/contracts",
    "build:contracts": "npm run build -w @techcapsule/contracts",
    "dev:api": "npm run dev -w @techcapsule/api",
    "dev:admin": "npm run dev -w @techcapsule/admin",
    "dev:mobile": "npm run start -w @techcapsule/mobile",
    "seed": "npm run seed -w @techcapsule/api",
    "create-admin": "npm run create-admin -w @techcapsule/api",
    "build": "npm run build:contracts && npm run build -w @techcapsule/api && npm run build -w @techcapsule/admin",
    "typecheck": "npm run build:contracts && npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run build:contracts && npm run test --workspaces --if-present"
  },
  "overrides": {
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.0.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1"
  }
}
