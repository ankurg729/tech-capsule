# Copy to .env.local (git-ignored). The admin panel talks to the API through the Vite dev
# proxy, so the browser only ever sees its own origin (required for the SameSite=Strict
# refresh cookie). Nothing here is bundled into the client.

# Where the dev/preview server forwards /api requests. Default: http://localhost:4000
# ADMIN_API_PROXY_TARGET=http://localhost:4000
