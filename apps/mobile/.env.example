# Copy to .env.local (git-ignored). Every EXPO_PUBLIC_* value is bundled into the
# app binary and readable by anyone who has it — never put secrets here.

# Base URL of the API including the /api/v1 prefix. Leave unset in development to
# auto-detect: the Metro host's LAN IP on port 4000, else 10.0.2.2 (Android
# emulator) or localhost (iOS simulator).
#
# Examples:
#   Android emulator:       http://10.0.2.2:4000/api/v1
#   iOS simulator:          http://localhost:4000/api/v1
#   Physical device (LAN):  http://192.168.1.20:4000/api/v1
# EXPO_PUBLIC_API_URL=
