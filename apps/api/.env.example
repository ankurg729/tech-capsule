# ---- Server ----
NODE_ENV=development
PORT=4000
# Bind to all interfaces so emulators and physical devices on your LAN can reach the API.
HOST=0.0.0.0
LOG_LEVEL=info
# Set to the number of reverse proxies in front of the API in production (e.g. 1). 0 = none.
TRUST_PROXY=0

# ---- Database ----
MONGODB_URI=mongodb://127.0.0.1:27017/techcapsule

# ---- Auth (generate each with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))") ----
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars
AUTH_CODE_SECRET=change-me-to-another-long-random-string-32-chars
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# ---- CORS: comma-separated origins allowed to call the API from a browser (admin panel) ----
CORS_ORIGINS=http://localhost:5173

# ---- Email ----
# log    = development only: emails are NOT sent; they are printed to the API console and
#          readable at GET /api/v1/dev/emails
# smtp   = any SMTP provider (Amazon SES, SendGrid, Brevo, Mailgun, Postmark SMTP, ...)
# resend = Resend HTTP API
EMAIL_PROVIDER=log
EMAIL_FROM="TechCapsule <no-reply@techcapsule.dev>"
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
RESEND_API_KEY=
# Deep-link scheme used inside emails so links open the mobile app.
APP_DEEP_LINK_BASE=techcapsule://

# ---- Rate limiting ----
RATE_LIMIT_ENABLED=true

# ---- Seed (optional): creates/updates an admin account when running `npm run seed` ----
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
